# Copy this file to .env and fill it in. .env is gitignored - keep it that way.

# ---- SMTP -------------------------------------------------------------------
# Gmail: host smtp.gmail.com, port 587, and an APP PASSWORD (not your account
# password) from https://myaccount.google.com/apppasswords - requires 2FA on.
# Outlook/M365: smtp.office365.com:587. Fastmail: smtp.fastmail.com:465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=

# ---- Identity ---------------------------------------------------------------
FROM_NAME=Your Name
FROM_EMAIL=you@example.com
REPLY_TO=
# Blind-copy yourself on every send, so your sent-folder thread history is intact.
BCC_SELF=true

# ---- Merge fields, available in templates as {{my_name}} etc. ----------------
MY_NAME=Your Name
MY_EMAIL=you@example.com
MY_PHONE=+00 00 000 0000
MY_LINKEDIN=linkedin.com/in/your-handle
MY_GITHUB=github.com/your-handle
MY_LOCATION=City, Country

# Used when a recipient has no hiring manager: "Dear Hiring Team,"
FALLBACK_GREETING=Hiring Team
# Used when a recipient has no role of their own.
DEFAULT_ROLE=

# ---- Throttling -------------------------------------------------------------
# Gap between messages, plus random jitter. Slow is good: bursts get you filtered.
SEND_DELAY_MS=8000
SEND_JITTER_MS=4000
# Hard stops. DAILY_CAP is enforced against the send log across restarts.
# Gmail's own limit is ~500/day, but personal outreach should be nowhere near it.
DAILY_CAP=40
BATCH_CAP=25

# ---- Attachments ------------------------------------------------------------
ATTACHMENTS_DIR=attachments
DEFAULT_ATTACHMENTS=Your-CV.pdf

PORT=3737
